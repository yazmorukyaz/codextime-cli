{
  "name": "codextime",
  "version": "0.5.1",
  "description": "Official CLI for syncing Codex usage metadata to Codextime",
  "homepage": "https://codexti.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazmorukyaz/codextime-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yazmorukyaz/codextime-cli/issues"
  },
  "bin": {
    "codextime": "dist/index.js"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "dist",
    "example-events.json",
    "example-usage.json",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^20.19.1",
    "esbuild": "0.25.12",
    "typescript": "^5.0.0"
  }
}
